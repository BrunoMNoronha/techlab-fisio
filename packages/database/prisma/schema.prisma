// M10 — Audit (docs/07 §7.9, §22.3)
// ---------------------------------------------------------------------------

/// H2.2-14, AUD-003, RN-061 — APPEND-ONLY (REVOKE em `E-11`).
/// `acao`, `alvo_tipo` e `resultado` são `text` + catálogo documentado e
/// NUNCA enum: AUD-003 cita os campos e NÃO enumera valores (§11.1, §22.3).
///
/// `alvo_id` permanece SEM FK — o alvo é POLIMÓRFICO (§22.3): FK polimórfica
/// é impossível e FKs para todas as tabelas tornariam a trilha frágil. Como
/// nada é apagado (§23), o risco de id inexistente é residual. NENHUMA FK deve
/// ser criada sobre esta coluna por conveniência.
///
/// PROIBIDO armazenar aqui (RN-062/063, AUD-002/006, TLF-BASE-V1 §10): senha
/// ou hash, token, cookie, segredo, conteúdo clínico, payload de prontuário,
/// conteúdo de anexo, dado pessoal sem necessidade demonstrada.
model EventoAuditoria {
  id            String   @id @default(uuid(7)) @db.Uuid
  ocorridoEm    DateTime @map("ocorrido_em") @db.Timestamptz(6)
  /// NULL somente em ação de sistema (RN-061).
  atorUsuarioId String?  @map("ator_usuario_id") @db.Uuid
  acao          String
  alvoTipo      String   @map("alvo_tipo")
  /// SEM FK — alvo polimórfico (§22.3).
  alvoId        String?  @map("alvo_id") @db.Uuid
  resultado     String
  justificativa String?
  correlacaoId  String   @map("correlacao_id") @db.Uuid
  /// LISTA BRANCA de chaves por `acao`, validada na aplicação (R2.2-04).
  contexto      Json?    @db.JsonB
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  ator Usuario? @relation(fields: [atorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// IDX-U1 — investigação por recurso (AUD-004) — §10-A.
  @@index([alvoTipo, alvoId, ocorridoEm])
  /// IDX-U2 — investigação por ator (AUD-004, RN-061) — §10-A.
  @@index([atorUsuarioId, ocorridoEm])
  /// IDX-U3 — reconstrução de uma operação (§22.3) — §10-A.
  @@index([correlacaoId])
  @@map("evento_auditoria")
}
