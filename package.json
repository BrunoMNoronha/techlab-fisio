{
  "name": "techlab-fisio",
  "version": "0.0.0",
  "private": true,
  "description": "TechLab Fisio — sistema de gestão para clínicas de fisioterapia (monorepositório npm workspaces).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/database",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @techlab-fisio/database && npm run build --workspace @techlab-fisio/api && npm run build --workspace @techlab-fisio/web",
    "test": "npm run test:integration && npm run test:api",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config packages/database/jest.config.mjs",
    "test:api": "npm run test --workspace @techlab-fisio/api",
    "verify:api-integration": "node scripts/verify-api-integration.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "verify:from-scratch": "node scripts/verify-from-scratch.mjs",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "schema:golden:update": "node scripts/schema-snapshot.mjs --update",
    "schema:verify": "node scripts/schema-snapshot.mjs --verify",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "typescript": "6.0.3"
  }
}
