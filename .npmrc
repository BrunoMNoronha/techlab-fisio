# Torna `engines` do package.json uma restrição efetiva, e não apenas um aviso.
# docs/08 §13 `E-01` exige que Node fora da linha 24.x seja RECUSADO; com o padrão
# do npm (engine-strict=false) a incompatibilidade produziria somente warning.
engine-strict=true

# Reprodutibilidade: instalações não devem inventar versões fora do lockfile.
save-exact=true
