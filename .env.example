# TechLab Fisio — modelo de variáveis de ambiente de DESENVOLVIMENTO.
#
# Copie para `.env` e substitua os valores. `.env` é ignorado pelo Git.
# TODOS os valores abaixo são SINTÉTICOS e existem apenas para o ambiente local
# em container. Nenhum deles é ou pode ser uma credencial real
# (TLF-BASE-V1 §10 e §14). Nunca use dado real de paciente em desenvolvimento.

# --- Ambiente da aplicação (Etapa 2.3D-B / F3, D-2.3D-07) --------------------
# OBRIGATÓRIA. Decide os atributos do cookie de sessão. Valores aceitos, e
# SOMENTE eles:
#   producao | homologacao | desenvolvimento | teste
#
# NÃO EXISTE DEFAULT E NÃO EXISTE FALLBACK. A aplicação não assume ambiente por
# omissão: ausente, vazia ou só com espaços ABORTA o bootstrap. A linha abaixo
# é um EXEMPLO de configuração local, não o comportamento na ausência da
# variável.
#
# producao/homologacao => `__Host-tlf_sessao` com HttpOnly, Secure,
# SameSite=Strict, Path=/ e sem Domain.
# desenvolvimento/teste => `tlf_sessao_dev`, sem Secure (HTTP local).
#
# FAIL-CLOSED (R-2.3D-04): ausência, valor desconhecido, ou NODE_ENV=production
# sem esta variável declarada como producao/homologacao ABORTAM o bootstrap —
# a API nunca sobe em produção com cookie de desenvolvimento.
TLF_AMBIENTE=desenvolvimento

# --- Container PostgreSQL 18 -------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=techlab_fisio

# Superusuário do container. Usado somente pelo entrypoint da imagem e pela
# criação inicial das roles. Não é usado pela aplicação nem pelas migrations.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_trocar_local

# --- Roles do projeto (separação obrigatória — docs/08 §13 E-02) -------------
# tlf_migrator: dono do schema; executa migrations; CREATEDB para o shadow.
TLF_MIGRATOR_USER=tlf_migrator
TLF_MIGRATOR_PASSWORD=dev_migrator_trocar_local

# tlf_app: runtime da aplicação; sem DDL; não é dona de nenhum objeto.
TLF_APP_USER=tlf_app
TLF_APP_PASSWORD=dev_app_trocar_local

# Shadow database do Prisma Migrate (docs/08 §5.5, ponto 6).
TLF_SHADOW_DB=techlab_fisio_shadow

# --- URLs de conexão ---------------------------------------------------------
# Runtime da aplicação — role SEM DDL.
DATABASE_URL=postgresql://tlf_app:dev_app_trocar_local@localhost:5432/techlab_fisio

# CLI do Prisma (migrations) — role de migration. NUNCA usar tlf_app aqui.
MIGRATE_DATABASE_URL=postgresql://tlf_migrator:dev_migrator_trocar_local@localhost:5432/techlab_fisio

# Shadow database usado por `prisma migrate dev`.
SHADOW_DATABASE_URL=postgresql://tlf_migrator:dev_migrator_trocar_local@localhost:5432/techlab_fisio_shadow
